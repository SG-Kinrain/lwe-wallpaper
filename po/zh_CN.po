msgid "Wallpaper"
msgstr "壁纸"

msgid "Renderer"
msgstr "渲染器"

msgid "linux-wallpaperengine not found — build it and set the path below"
msgstr "找不到 linux-wallpaperengine —— 请先编译安装，然后在下方填写路径"

msgid "Executable path"
msgstr "可执行文件路径"

msgid "Default scene"
msgstr "默认场景"

msgid "Used by every monitor unless overridden below"
msgstr "所有显示器共用，除非在下方单独指定"

msgid "Scene"
msgstr "场景"

msgid "Not selected"
msgstr "未选择"

msgid "Or enter a scene folder path"
msgstr "或直接填写场景目录路径"

msgid "Frame rate"
msgstr "帧率"

msgid "30 is lighter, 60 is smoother"
msgstr "30 更省电，60 更顺滑"

msgid "Scaling"
msgstr "缩放方式"

msgid "fill crops, fit letterboxes, stretch distorts"
msgstr "fill 裁切铺满 · fit 完整显示（留黑边）· stretch 拉伸"

msgid "Keep renderer below other windows"
msgstr "把渲染器压在窗口栈底层"

msgid "Per-monitor overrides"
msgstr "按显示器单独设置"

msgid "Leave empty to follow the default scene"
msgstr "留空表示跟随默认场景"

msgid "Monitor"
msgstr "显示器"

msgid "Follows default"
msgstr "跟随默认"

msgid "Frame rate (0 = follow default)"
msgstr "帧率（0 = 跟随默认）"

msgid "Save and apply"
msgstr "保存并应用"

msgid "Restarts the renderer, no logout needed"
msgstr "重启渲染器，无需注销"

msgid "Apply"
msgstr "应用"

msgid "Saved, restarting renderer…"
msgstr "已保存，正在重启渲染器…"

msgid "Configuration file"
msgstr "配置文件"
